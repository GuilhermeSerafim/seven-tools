# ─── Template de variáveis de ambiente ────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com seus valores reais.
# cp .env.example .env.local

# API base URL used by the axios client in local, preview, and production builds.
# Local development should keep the FastAPI default unless you intentionally proxy it.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Groq API Key — obtenha em https://console.groq.com
# Usado apenas no modo direto (dev/staging). Em produção, prefira VITE_GROQ_PROXY_URL.
VITE_GROQ_API_KEY=your_groq_api_key_here

# Proxy server-side para o Groq (produção) — esconde a chave no servidor.
# O proxy deve aceitar POST /chat/completions com o mesmo body da API Groq
# e adicionar o header Authorization server-side.
# Quando configurado, VITE_GROQ_API_KEY é ignorada no cliente.
# VITE_GROQ_PROXY_URL=https://your-api.com/api/groq
